# 速传 nginx 反代配置示例
# 假设域名是 chuan.example.com，请全局替换成你的真实子域名。
# 放到 /etc/nginx/conf.d/transfer.conf（Debian/Ubuntu 也可以放 sites-enabled/）

server {
    listen 80;
    server_name chuan.example.com;

    # 第一步先跑通 HTTP；然后用 certbot 签证书：
    #   sudo certbot --nginx -d chuan.example.com
    # certbot 会自动改写这个文件加上 301 跳转和证书配置。

    # 50MB 文件上传 + 表单开销，给足余量
    client_max_body_size 60m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
